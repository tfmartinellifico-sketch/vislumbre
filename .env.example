# Firebase Web App — copie para .env.local e preencha pelo Firebase Console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL pública (produção: vislumbre.me)
NEXT_PUBLIC_APP_URL=https://vislumbre.me

# E-mails com acesso ao painel /admin (vírgula). Preferir também ADMIN_EMAILS no server.
NEXT_PUBLIC_ADMIN_EMAILS=seu@email.com
ADMIN_EMAILS=seu@email.com

# Firebase Admin SDK (JSON em uma linha) — bootstrap de claim admin + webhook Stripe
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Resend — use o domínio JÁ verificado na sua conta (ex.: core2.capital)
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Vislumbre <suporte@core2.capital>
# ADMIN_NOTIFY_EMAIL=suporte@core2.capital

# Stripe — assinatura mensal/anual + webhook em https://vislumbre.me/api/billing/webhook
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_MENSAL=price_xxx
# STRIPE_PRICE_ANUAL=price_xxx
