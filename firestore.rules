rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdminClaim() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isAdminDoc() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isAdminClaim() || isAdminDoc();
    }

    function isClinicMember(clinicId) {
      return signedIn()
        && exists(/databases/$(database)/documents/clinics/$(clinicId)/members/$(request.auth.uid));
    }

    function isClinicOwnerOrAdmin(clinicId) {
      return isClinicMember(clinicId)
        && get(/databases/$(database)/documents/clinics/$(clinicId)/members/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }

    // Preferível: escrita só via Admin SDK (/api/admin/bootstrap) + claim admin.
    // Self-create permanece como fallback se FIREBASE_SERVICE_ACCOUNT ainda não estiver na Vercel.
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, create, update, delete:
        if signedIn() && request.auth.uid == userId;
      allow read: if isAdmin();

      match /consultations/{consultationId} {
        allow read, create, update, delete:
          if signedIn() && request.auth.uid == userId;
        allow read: if isAdmin();
      }
    }

    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll([
          'name', 'email', 'phone', 'clinic', 'city', 'message', 'status', 'source', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.status in ['novo', 'demo_solicitado'];
      allow read, update, delete: if isAdmin();
    }

    match /clinics/{clinicId} {
      allow read: if isAdmin() || isClinicMember(clinicId);
      allow create: if signedIn();
      // Status / plano / assentos / ambiente / Stripe: só admin (ou Admin SDK no webhook)
      allow update: if isAdmin()
        || (isClinicOwnerOrAdmin(clinicId)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['status', 'plan', 'seats', 'environment', 'stripeCustomerId', 'stripeSubscriptionId', 'leadId']));
      allow delete: if isAdmin();

      match /members/{memberId} {
        allow read: if isAdmin() || isClinicMember(clinicId);
        allow create, update: if isAdmin()
          || (signedIn() && request.auth.uid == memberId)
          || isClinicOwnerOrAdmin(clinicId);
        allow delete: if isAdmin() || isClinicOwnerOrAdmin(clinicId)
          || (signedIn() && request.auth.uid == memberId);
      }
    }

    match /invites/{inviteId} {
      allow get: if true;
      allow list: if isAdmin() || signedIn();
      allow create: if isAdmin() || signedIn();
      allow update: if isAdmin()
        || (signedIn() && resource.data.email == request.auth.token.email);
      allow delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
    }

    match /usage_events/{eventId} {
      allow create: if
        (signedIn()
          && request.resource.data.keys().hasAll(['type', 'userId', 'clinicId', 'createdAt'])
          && request.resource.data.userId == request.auth.uid)
        || (request.resource.data.type == 'page_lead'
          && request.resource.data.userId == null
          && request.resource.data.keys().hasAll(['type', 'userId', 'clinicId', 'createdAt']));
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
